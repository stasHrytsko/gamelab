{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "PuzzleKit UI",
    "version": "2.0.0",
    "source": "UI Design: ui-kit-board-overview.jpg, ui-kit-board-detail.webp (legacy/ — прежние референсы v1)",
    "rule": "These tokens override values inferred from screenshots."
  },
  "color": {
    "brand": {
      "blue": "#8FA7C7",
      "coral": "#E56B5D",
      "yellow": "#E0B44C",
      "green": "#7DB5A7",
      "purple": "#B38760"
    },
    "neutral": {
      "background": "#EDE4D8",
      "surface": "#F7F1E8",
      "surfaceMuted": "#E4D9CB",
      "border": "#D9CCBB",
      "text": "#3B3B3B",
      "textMuted": "#7A7167"
    },
    "semantic": {
      "primary": "#E56B5D",
      "success": "#5FA08F",
      "warning": "#E0B44C",
      "danger": "#D14B45",
      "disabled": "#C9BFB2"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "Zen Maru Gothic",
      "fallback": "Poppins, Inter, Manrope, Segoe UI, sans-serif"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSizePx": {
      "caption": 11,
      "small": 12,
      "body": 14,
      "button": 16,
      "heading3": 18,
      "heading2": 24,
      "heading1": 32
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.4,
      "relaxed": 1.6
    }
  },
  "spacingPx": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "radiusPx": {
    "small": 8,
    "medium": 12,
    "large": 16,
    "card": 20,
    "pill": 999
  },
  "shadow": {
    "soft": "0 6px 16px rgba(92, 70, 48, 0.12)",
    "card": "0 10px 26px rgba(92, 70, 48, 0.14)",
    "tile": "0 4px 8px rgba(80, 55, 35, 0.25)"
  },
  "component": {
    "buttonHeightPx": 48,
    "tileSizePx": 64,
    "iconSizePx": 24,
    "cardPaddingPx": 20,
    "minimumTouchTargetPx": 44,
    "motionDurationMs": {
      "fast": 120,
      "normal": 220,
      "slow": 360
    }
  },
  "themes": {
    "tomb": {
      "description": "Тёмная тема только для «Раскопа» (specs/24-excavation.md), одобрена автором 2026-09-27. Переопределяет нейтральные цвета и тени; брендовые цвета те же.",
      "selector": "[data-theme=\"tomb\"]",
      "color": {
        "neutral": {
          "background": "#11141B",
          "surface": "#1B202A",
          "surfaceMuted": "#262C38",
          "border": "#2F3644",
          "text": "#EEF2F8",
          "textMuted": "#9AA3B2"
        },
        "semantic": {
          "disabled": "#454D5C"
        },
        "game": {
          "stone": "#5D6678",
          "clue1": "#7B9DFF",
          "clue2": "#34D399",
          "clue3": "#FF7B6B",
          "clue4": "#A78BFA",
          "clue5": "#FF5FA2"
        }
      },
      "shadow": {
        "soft": "0 6px 18px rgba(0, 0, 0, 0.35)",
        "card": "0 10px 30px rgba(0, 0, 0, 0.45)",
        "tile": "0 7px 14px rgba(0, 0, 0, 0.45)"
      }
    }
  }
}
